<Window x:Class="Reminders.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Reminders.Windows"
 xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
 <Grid x:Name="Root" SizeChanged="Root_SizeChanged" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
   <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AppleTheme.xaml"/></ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="AppleReminderTemplate" x:DataType="local:ReminderItem">
     <Grid Margin="{x:Bind HierarchyIndent, Mode=OneWay}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox Margin="8,7,0,0" IsChecked="{Binding Completed, Mode=TwoWay}" Click="Complete_Click" Style="{StaticResource AppleCheckBoxStyle}"
                VerticalAlignment="Top" x:Uid="AppleCompletionButton"/>
      <StackPanel Grid.Column="1" Padding="{x:Bind RowPadding, Mode=OneWay}" Spacing="3" MinHeight="40" VerticalAlignment="Center">
       <TextBlock Text="{Binding DisplayTitle, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource AppleTextBrush}" TextTrimming="CharacterEllipsis"/>
       <Grid ColumnSpacing="6" Visibility="{Binding AppleMetadataVisibility, Mode=OneWay}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding PriorityMarks, Mode=OneWay}" Foreground="{ThemeResource AppleBlueBrush}" FontWeight="Bold" FontSize="13"
                   AutomationProperties.Name="{Binding PriorityLabel, Mode=OneWay}" ToolTipService.ToolTip="{Binding PriorityLabel, Mode=OneWay}"/>
        <TextBlock Grid.Column="1" Text="{Binding AppleScheduleText, Mode=OneWay}" Foreground="{Binding AppleDueBrush, Mode=OneWay}" FontSize="13" MaxWidth="230" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding AppleTags, Mode=OneWay}" Foreground="{ThemeResource AppleBlueBrush}" FontSize="13" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" Text="{Binding ApplePending, Mode=OneWay}" Foreground="{ThemeResource AppleBlueBrush}" FontSize="13" AutomationProperties.Name="{Binding AppleSyncDescription}"/>
       </Grid>
      </StackPanel>
      <Border Grid.Column="1" Grid.ColumnSpan="2" Height="1" Margin="8,0,10,0" Background="{ThemeResource AppleDividerBrush}" VerticalAlignment="Bottom"/>
      <Button Grid.Column="2" Style="{StaticResource AppleToolbarButtonStyle}" VerticalAlignment="Top" Margin="0,3,4,0"
              Visibility="{x:Bind SubtaskToggleVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind SubtaskToggleLabel, Mode=OneWay}"
              ToolTipService.ToolTip="{x:Bind SubtaskToggleLabel, Mode=OneWay}" Click="ToggleSubtasks_Click">
       <FontIcon Glyph="{x:Bind SubtaskGlyph, Mode=OneWay}" FontSize="12"/>
      </Button>
     </Grid>
    </DataTemplate>

   </ResourceDictionary>
  </Grid.Resources>
  <Grid.KeyboardAccelerators>
   <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewAccelerator_Invoked"/>
   <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked"/>
  </Grid.KeyboardAccelerators>
  <NavigationView x:Uid="Navigation" x:Name="Navigation" IsBackButtonVisible="Collapsed"
                  PaneDisplayMode="LeftCompact" IsPaneOpen="True" OpenPaneLength="260" CompactPaneLength="48"
                  IsSettingsVisible="True" IsPaneToggleButtonVisible="True" AlwaysShowHeader="False" IsTitleBarAutoPaddingEnabled="False"
                  PaneOpening="Navigation_PaneOpening" PaneClosing="Navigation_PaneClosing"
                  ItemInvoked="Navigation_ItemInvoked" SelectionChanged="Navigation_SelectionChanged">
   <NavigationView.Resources>
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
    <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
   </NavigationView.Resources>
   <NavigationView.MenuItems>
    <NavigationViewItem x:Uid="TodayNavigationViewItem" Tag="smart:today"><NavigationViewItem.Icon><FontIcon Glyph="&#xE823;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Uid="UpcomingNavigationViewItem" Tag="smart:upcoming"><NavigationViewItem.Icon><FontIcon Glyph="&#xE787;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Uid="AllNavigationViewItem" Tag="smart:all"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Uid="CompletedNavigationViewItem" Tag="smart:completed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Uid="DeletedNavigationViewItem" Tag="smart:deleted"><NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemSeparator/>
    <NavigationViewItemHeader x:Uid="MyListsNavigationViewItemHeader"/>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem x:Uid="ConflictItem" x:Name="ConflictItem" SelectsOnInvoked="False" Tag="conflicts" Visibility="Collapsed"><NavigationViewItem.Icon><FontIcon Glyph="&#xE814;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Uid="SyncNowNavigationViewItem" SelectsOnInvoked="False" Tag="sync"><NavigationViewItem.Icon><FontIcon Glyph="&#xE895;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="AppleSidebarColumn" Width="0"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid x:Name="AppleSidebar" Visibility="Collapsed" Background="{ThemeResource AppleSidebarBrush}" BorderBrush="{ThemeResource AppleDividerBrush}" BorderThickness="0,0,1,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="16,12,10,8">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Uid="AppleSidebarTitle" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AppleTextBrush}" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Style="{StaticResource AppleToolbarButtonStyle}" Click="AppleSync_Click" x:Uid="AppleSidebarSync"><FontIcon Glyph="&#xE895;" FontSize="16"/></Button>
      <Button Grid.Column="2" Style="{StaticResource AppleToolbarButtonStyle}" Click="AppleSettings_Click" x:Uid="AppleSidebarSettings"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
     </Grid>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <ListView x:Name="AppleSmartLists" SelectionChanged="AppleNavigation_SelectionChanged" ItemContainerStyle="{StaticResource AppleRowStyle}" Padding="8,0"/>
       <Border Height="1" Background="{ThemeResource AppleDividerBrush}" Margin="12,10,12,9"/>
       <TextBlock x:Uid="AppleSidebarLists" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="45" Margin="16,0,0,6"/>
       <ListView x:Name="AppleLists" SelectionChanged="AppleNavigation_SelectionChanged" ItemContainerStyle="{StaticResource AppleRowStyle}" Padding="8,0"/>
       <StackPanel x:Name="AppleTagsSection" Visibility="Collapsed">
        <Border Height="1" Background="{ThemeResource AppleDividerBrush}" Margin="12,10,12,9"/>
        <TextBlock x:Uid="AppleSidebarTags" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="45" Margin="16,0,0,6"/>
        <ItemsControl x:Name="AppleTags" Margin="18,0,12,14">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="2" BorderBrush="{ThemeResource AppleDividerBrush}" BorderThickness="0,1,0,0" Padding="18,12" Spacing="4">
      <Button x:Name="AppleConflicts" x:Uid="AppleConflicts" Visibility="Collapsed" Click="AppleConflicts_Click"/>
      <TextBlock x:Name="AppleSyncStatus" x:Uid="AppleSyncStatus" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="ReminderLayout" Grid.Column="1" SizeChanged="ReminderLayout_SizeChanged" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ReminderColumn"/><ColumnDefinition x:Name="SplitterColumn" Width="8"/><ColumnDefinition x:Name="DetailsColumn"/></Grid.ColumnDefinitions>
     <Grid x:Name="ReminderHost" Style="{StaticResource WindowsReminderHostStyle}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="ReminderHeader" Margin="24,0,24,12" MinHeight="64" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock x:Uid="ViewTitle" x:Name="ViewTitle" TextTrimming="CharacterEllipsis" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock x:Name="ViewSubtitle" Visibility="Collapsed" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="ApplePaneButton" Visibility="Collapsed" Style="{StaticResource AppleToolbarButtonStyle}" Click="ApplePane_Click" x:Uid="ApplePaneButton"><FontIcon Glyph="&#xE700;" FontSize="18"/></Button>
        <Button x:Name="AppleSearchButton" Visibility="Collapsed" Style="{StaticResource AppleToolbarButtonStyle}" Click="AppleSearch_Click" x:Uid="AppleSearchButton"><FontIcon Glyph="&#xE721;" FontSize="18"/></Button>
        <Button x:Name="AppleSortButton" Visibility="Collapsed" Style="{StaticResource AppleToolbarButtonStyle}" Click="AppleSort_Click" x:Uid="AppleSortButton"><FontIcon Glyph="&#xE8CB;" FontSize="18"/></Button>
        <Button x:Uid="AddButton" x:Name="AddButton" Height="36" MinWidth="36" VerticalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" Click="Add_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock x:Uid="AddLabel" x:Name="AddLabel"/></StackPanel></Button>
       </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1">
       <Grid x:Name="SearchRow" Padding="24,0,24,12" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <AutoSuggestBox x:Uid="SearchBox" x:Name="SearchBox" QueryIcon="Find" TextChanged="SearchBox_TextChanged" MinHeight="40" VerticalAlignment="Center"/>
        <Button x:Uid="SortButton" x:Name="SortButton" Grid.Column="1" Width="40" Height="40"><Button.Flyout><MenuFlyout><RadioMenuFlyoutItem x:Uid="ManualRadioMenuFlyoutItem" Tag="manual" GroupName="sort" IsChecked="True" Click="Sort_Click"/><RadioMenuFlyoutItem x:Uid="DueDateRadioMenuFlyoutItem" Tag="due" GroupName="sort" Click="Sort_Click"/><RadioMenuFlyoutItem x:Uid="PriorityRadioMenuFlyoutItem" Tag="priority" GroupName="sort" Click="Sort_Click"/><RadioMenuFlyoutItem x:Uid="TitleRadioMenuFlyoutItem" Tag="title" GroupName="sort" Click="Sort_Click"/></MenuFlyout></Button.Flyout><FontIcon Glyph="&#xE8CB;" FontSize="18"/></Button>
       </Grid>
       <CheckBox x:Name="AppleShowCompleted" x:Uid="AppleShowCompleted" Visibility="Collapsed" Foreground="{ThemeResource AppleSecondaryBrush}" Margin="28,0,20,6" Click="AppleShowCompleted_Click"/>
      </StackPanel>
      <ListView x:Name="ReminderList" Grid.Row="2" SelectionChanged="ReminderList_SelectionChanged" IsItemClickEnabled="False" Padding="8,0">
       <ListView.GroupStyle><GroupStyle HidesIfEmpty="True">
        <GroupStyle.HeaderContainerStyle><Style TargetType="ListViewHeaderItem"><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/></Style></GroupStyle.HeaderContainerStyle>
        <GroupStyle.HeaderTemplate><DataTemplate x:DataType="local:ReminderSection"><TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="14,10,14,2"/></DataTemplate></GroupStyle.HeaderTemplate>
       </GroupStyle></ListView.GroupStyle>
       <ListView.ItemContainerTransitions><TransitionCollection><AddDeleteThemeTransition/><ReorderThemeTransition/></TransitionCollection></ListView.ItemContainerTransitions>
       <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,1"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="6"/></Style></ListView.ItemContainerStyle>
       <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:ReminderItem">
         <Grid Padding="{x:Bind RowPadding, Mode=OneWay}" Margin="{x:Bind HierarchyIndent, Mode=OneWay}" MinHeight="40">
          <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <CheckBox x:Uid="MarkReminderCompleteCheckBox" IsChecked="{x:Bind Completed, Mode=TwoWay}" Click="Complete_Click" VerticalAlignment="Top"/>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
           <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}" FontWeight="{x:Bind RowTitleWeight, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{x:Bind Metadata, Mode=OneWay}" Visibility="{x:Bind MetadataVisibility, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{x:Bind Metadata, Mode=OneWay}" Visibility="{x:Bind OverdueMetadataVisibility, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{x:Bind Description, Mode=OneWay}" Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="2" Style="{ThemeResource SubtleButtonStyle}" Width="32" Height="32" MinWidth="0" Padding="0" Margin="4,-4,0,0" VerticalAlignment="Top"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind SubtaskToggleVisibility, Mode=OneWay}"
                  AutomationProperties.Name="{x:Bind SubtaskToggleLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind SubtaskToggleLabel, Mode=OneWay}" Click="ToggleSubtasks_Click">
           <FontIcon Glyph="{x:Bind SubtaskGlyph, Mode=OneWay}" FontSize="12"/>
          </Button>
         </Grid>
        </DataTemplate>
       </ListView.ItemTemplate>
      </ListView>
      <Grid x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24" MaxWidth="320"><FontIcon Glyph="&#xE90C;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/><TextBlock x:Uid="EmptyStateTitle" x:Name="EmptyStateTitle" TextWrapping="Wrap" TextAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock x:Uid="EmptyStateMessage" x:Name="EmptyStateMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
      <Grid x:Name="ReminderFooter" Grid.Row="3" Padding="24,12,24,16" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ToggleSwitch x:Uid="ShowCompleted" x:Name="ShowCompleted" MinWidth="0" VerticalAlignment="Center" Toggled="ShowCompleted_Toggled"/><TextBlock x:Name="RowCount" Grid.Column="1" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
     </Grid>
     <Border x:Name="ApplePaneSeparator" Grid.Column="1" Width="1" HorizontalAlignment="Center"
             Background="{ThemeResource AppleDividerBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
     <primitives:Thumb x:Uid="PaneDivider" x:Name="PaneDivider" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsTabStop="True" UseSystemFocusVisuals="True"
       DragStarted="PaneDivider_DragStarted" DragDelta="PaneDivider_DragDelta" DragCompleted="PaneDivider_DragCompleted"
       KeyDown="PaneDivider_KeyDown" DoubleTapped="PaneDivider_DoubleTapped">
      <primitives:Thumb.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Uid="SizePanesAutomaticallyMenuFlyoutItem" Click="AutomaticPaneSizing_Click"/></MenuFlyout></primitives:Thumb.ContextFlyout>
      <primitives:Thumb.Template><ControlTemplate TargetType="primitives:Thumb"><Grid Background="Transparent">
       <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
         <VisualState x:Name="Normal"/>
         <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="DividerVisual.Opacity" Value="1"/></VisualState.Setters></VisualState>
         <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="DividerVisual.Opacity" Value="1"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
        <VisualStateGroup x:Name="FocusStates">
         <VisualState x:Name="Unfocused"/>
         <VisualState x:Name="PointerFocused"/>
         <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="DividerVisual.Opacity" Value="1"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
       </VisualStateManager.VisualStateGroups>
       <Border x:Name="DividerVisual" Width="4" Height="40" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0"/>
      </Grid></ControlTemplate></primitives:Thumb.Template>
     </primitives:Thumb>
     <Grid x:Name="DetailsHost" Grid.Column="2" Style="{StaticResource WindowsDetailsHostStyle}">
      <StackPanel x:Name="NoSelection" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24" MaxWidth="320"><FontIcon Glyph="&#xE8A5;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Uid="SelectAReminderTextBlock" TextWrapping="Wrap" TextAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock x:Uid="ItsDetailsWillAppearHereTextBlock" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <Grid x:Name="DetailPane" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid x:Name="DetailHeader" Padding="20,12" MaxWidth="620" HorizontalAlignment="Stretch" MinHeight="64">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Uid="BackToReminders" x:Name="BackToReminders" Margin="0,0,12,0" Click="BackToReminders_Click" Visibility="Collapsed" VerticalAlignment="Center"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button>
        <StackPanel x:Name="DetailHeading" Grid.Column="1" Spacing="2"><TextBlock x:Uid="TaskDetailsTextBlock" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="DetailListName" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
        <Button x:Uid="TaskActionsButton" x:Name="DetailActions" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"><FontIcon Glyph="&#xE712;" FontSize="16"/><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Uid="DeleteTaskMenuFlyoutItem" Click="Delete_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout></Button>
       </Grid>
       <ScrollViewer x:Name="DetailScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <Grid>
        <StackPanel x:Name="DetailFields" Padding="20,0,20,20" MaxWidth="620" HorizontalAlignment="Stretch" Spacing="16">
         <TextBox x:Uid="DetailTitle" x:Name="DetailTitle" Style="{StaticResource TaskTitleEditorStyle}" TextChanged="Detail_Changed"/>
         <TextBox x:Uid="DetailNotes" x:Name="DetailNotes" Style="{StaticResource TaskNotesEditorStyle}" TextChanged="Detail_Changed"/>
         <ComboBox x:Uid="DetailList" x:Name="DetailList" DisplayMemberPath="Title" SelectedValuePath="Id" HorizontalAlignment="Stretch" SelectionChanged="Detail_Changed"/>
         <Button x:Uid="AddSubtaskButton" x:Name="AddSubtaskButton" Click="AddSubtask_Click"/>
         <Border x:Name="DetailScheduleCard" Style="{StaticResource EditorSectionStyle}">
          <StackPanel Spacing="10">
           <TextBlock x:Uid="ScheduleTextBlock" x:Name="DetailScheduleHeading" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
           <Grid x:Name="DetailDateTime" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CalendarDatePicker x:Uid="DetailDate" x:Name="DetailDate" HorizontalAlignment="Stretch" DateChanged="Detail_Changed"/><TimePicker x:Uid="DetailTime" x:Name="DetailTime" Grid.Column="1" HorizontalAlignment="Stretch" TimeChanged="Detail_Changed"/></Grid>
           <Button x:Name="AppleClearDue" x:Uid="AppleClearDue" Visibility="Collapsed" HorizontalAlignment="Left" Foreground="{ThemeResource AppleBlueBrush}" Background="Transparent" BorderThickness="0" Click="AppleClearDue_Click"/>
           <Grid x:Name="DetailAllDayRow"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Uid="AllDayTextBlock" VerticalAlignment="Center"/><ToggleSwitch x:Uid="DetailAllDay" x:Name="DetailAllDay" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="Detail_Changed"/></Grid>
           <Grid x:Name="DetailRecurrence" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Uid="DetailRepeatChoice" x:Name="DetailRepeatChoice" HorizontalAlignment="Stretch" SelectionChanged="Detail_Changed"><ComboBoxItem x:Uid="NeverComboBoxItem"/><ComboBoxItem x:Uid="DailyComboBoxItem"/><ComboBoxItem x:Uid="WeeklyComboBoxItem"/><ComboBoxItem x:Uid="MonthlyComboBoxItem"/><ComboBoxItem x:Uid="YearlyComboBoxItem"/></ComboBox><NumberBox x:Uid="DetailRepeatInterval" x:Name="DetailRepeatInterval" Grid.Column="1" Minimum="1" Maximum="999" Value="1" SpinButtonPlacementMode="Compact" ValueChanged="Detail_Changed"/></Grid>
           <TextBlock x:Name="DetailRepeatHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
          </StackPanel>
         </Border>
         <Expander x:Uid="DetailMore" x:Name="DetailMore" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
          <StackPanel x:Name="DetailMoreFields" Spacing="16">
           <StackPanel x:Name="DetailTagsSection" Spacing="6" Visibility="Collapsed"><TextBlock x:Uid="TagsTextBlock" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="DetailTags" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Uid="ManageTagsInAppleRemindersTextBlock" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
           <Grid x:Name="DetailOptions" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Uid="DetailPriority" x:Name="DetailPriority" HorizontalAlignment="Stretch" SelectionChanged="Detail_Changed"></ComboBox><ToggleSwitch x:Uid="DetailFlagged" x:Name="DetailFlagged" Grid.Column="1" Toggled="Detail_Changed"/></Grid>
          </StackPanel>
         </Expander>
         <TextBlock x:Name="AppleDetailStatus" Visibility="Collapsed" Foreground="{ThemeResource AppleSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        </Grid>
       </ScrollViewer>
       <Border x:Name="DetailFooter" Grid.Row="2" Style="{StaticResource WindowsDetailFooterStyle}">
        <Grid Padding="20,12" MaxWidth="620" HorizontalAlignment="Stretch" ColumnSpacing="10">
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="AppleDeleteColumn" Width="0"/></Grid.ColumnDefinitions>
         <Button x:Uid="SaveButton" x:Name="SaveButton" MinWidth="140" Height="36" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Right" IsEnabled="False" Click="Save_Click"/>
         <Button x:Name="AppleDeleteButton" Grid.Column="1" x:Uid="AppleDeleteButton" Visibility="Collapsed" Height="36" HorizontalAlignment="Stretch"
                 Style="{StaticResource AppleDeleteButtonStyle}" Click="Delete_Click"/>
        </Grid>
       </Border>
      </Grid>
     </Grid>
    </Grid>
    <StackPanel x:Name="StatusBanners" Grid.ColumnSpan="2" Visibility="Collapsed" VerticalAlignment="Top" Canvas.ZIndex="10">
     <StackPanel.Resources><x:Double x:Key="InfoBarMinHeight">64</x:Double></StackPanel.Resources>
     <Border x:Name="UpdateBannerSurface" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Translation="0,0,16">
      <Border.Shadow><ThemeShadow/></Border.Shadow>
      <InfoBar x:Name="UpdateInfoBar" IsOpen="False" Visibility="Collapsed" IsClosable="True" Severity="Informational" CornerRadius="0" BorderThickness="0">
       <InfoBar.ActionButton><Button x:Uid="UpdateButton" x:Name="UpdateButton" Click="Update_Click"/></InfoBar.ActionButton>
      </InfoBar>
     </Border>
     <Border x:Name="AppBannerSurface" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Translation="0,0,16">
      <Border.Shadow><ThemeShadow/></Border.Shadow>
      <InfoBar x:Name="AppInfoBar" IsOpen="False" Visibility="Collapsed" IsClosable="True" CornerRadius="0" BorderThickness="0"/>
     </Border>
    </StackPanel>
   </Grid>
  </NavigationView>

  <ContentControl x:Name="AuthGate" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16" Padding="28" MaxWidth="480" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="24"/></TransitionCollection></Border.Transitions>
    <StackPanel Spacing="12">
     <Image x:Uid="RemindersForWindowsIconImage" Source="Assets/icon-v2.png" Width="64" Height="64" HorizontalAlignment="Center"/>
     <TextBlock x:Uid="RemindersForWindowsTextBlock" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
     <TextBlock x:Uid="YourICloudRemindersAtHomeOnTextBlock" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
     <ProgressBar x:Name="GateProgress" IsIndeterminate="True"/>
     <!-- Wrap rather than centre-and-overflow: these messages carry masked
          phone numbers and Apple's own wording, so they routinely exceed the
          card width. Unwrapped, the text is clipped on both sides and widens
          the panel enough to clip the fields below it too. -->
     <TextBlock x:Uid="GateStatus" x:Name="GateStatus" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Stretch" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <StackPanel x:Name="LoginFields" Spacing="12" Visibility="Collapsed">
      <Button x:Uid="AppleDeviceSignIn" x:Name="AppleDeviceSignIn" HorizontalAlignment="Stretch" Click="BrowserSignIn_Click"/>
      <TextBlock x:Uid="ContinueOnAppleSSignInTextBlock" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Uid="OrEnterYourAccountForTextTextBlock" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBox x:Uid="AppleIdBox" x:Name="AppleIdBox"/>
      <PasswordBox x:Uid="PasswordBox" x:Name="PasswordBox"/>
      <Button x:Uid="SignInWithTextVerificationButton" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="SignIn_Click"/>
      <TextBlock x:Uid="ThisPCRemembersYourTrustedSessionTextBlock" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
     <StackPanel x:Name="CodeFields" Spacing="12" Visibility="Collapsed"><TextBox x:Uid="CodeBox" x:Name="CodeBox" MaxLength="16"/><Button x:Uid="VerifyCode" x:Name="VerifyCode" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="Verify_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4"><HyperlinkButton x:Uid="ResendCode" x:Name="ResendCode" Click="ResendCode_Click"/><HyperlinkButton x:Uid="TextCode" x:Name="TextCode" Visibility="Collapsed" Click="TextCode_Click"/></StackPanel><HyperlinkButton x:Uid="UseAppleDeviceVerificationHyperlinkButton" HorizontalAlignment="Center" Click="BrowserSignIn_Click"/><HyperlinkButton x:Uid="RestartSignIn" x:Name="RestartSignIn" HorizontalAlignment="Center" Click="RestartSignIn_Click"/></StackPanel>
     <InfoBar x:Name="GateError" IsOpen="False" Severity="Error" IsClosable="False">
      <InfoBar.ActionButton><Button x:Uid="ReviewICloudSetupButton" Click="ReviewICloudSetup_Click"/></InfoBar.ActionButton>
     </InfoBar>
     <HyperlinkButton x:Uid="SetupHelpLink" x:Name="SetupHelpLink" HorizontalAlignment="Center" Click="ReviewICloudSetup_Click"/>
     <HyperlinkButton x:Uid="SettingsAndStorageHyperlinkButton" HorizontalAlignment="Center" Click="Settings_Click"/>
     <HyperlinkButton x:Uid="PrivacyPolicyHyperlinkButton" HorizontalAlignment="Center" Click="PrivacyPolicy_Click"/>
    </StackPanel>
   </Border>
   </ScrollViewer>
  </ContentControl>

  <Grid x:Name="WelcomeScreen" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" TabFocusNavigation="Cycle">
   <Border x:Name="WelcomeCard" MaxWidth="560" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
           Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16">
    <Border.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="16"/></TransitionCollection></Border.Transitions>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Spacing="12" Margin="0,0,0,24">
      <Image Source="Assets/icon-v2.png" Width="64" Height="64" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw"/>
      <TextBlock x:Uid="WelcomeHeading" x:Name="WelcomeHeading" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
      <TextBlock x:Uid="WelcomeSubtitle" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="20">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top"><FontIcon Glyph="&#xE753;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Border>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Uid="WelcomeSyncTitle" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Uid="WelcomeSyncDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
       </Grid>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top"><FontIcon Glyph="&#xE823;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Border>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Uid="WelcomeFocusTitle" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Uid="WelcomeFocusDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
       </Grid>
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top"><FontIcon Glyph="&#xE8FB;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Border>
        <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Uid="WelcomeOfflineTitle" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Uid="WelcomeOfflineDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
       </Grid>
      </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0">
      <StackPanel Spacing="8">
       <Button x:Uid="WelcomeContinue" x:Name="WelcomeContinue" Click="WelcomeContinue_Click" HorizontalAlignment="Stretch" MinHeight="40" Style="{ThemeResource AccentButtonStyle}"/>
       <HyperlinkButton x:Uid="WelcomeDemo" Click="WelcomeDemo_Click" HorizontalAlignment="Center"/>
       <HyperlinkButton x:Uid="WelcomePrivacy" Click="PrivacyPolicy_Click" HorizontalAlignment="Center" FontSize="12"/>
      </StackPanel>
     </Border>
    </Grid>
   </Border>
  </Grid>

  <Grid x:Name="SetupGuide" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Border x:Name="SetupCard" MaxWidth="560" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Spacing="12" Margin="0,0,0,24">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Uid="SetupGuideHeading" x:Name="SetupGuideHeading" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
       <TextBlock x:Name="SetupStepCount" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
       <Button x:Uid="SetupReturn" x:Name="SetupReturn" Grid.Column="2" Width="32" Height="32" Padding="0" Visibility="Collapsed" Click="SetupReturn_Click"><FontIcon Glyph="&#xE8BB;" FontSize="12"/></Button>
      </Grid>
      <ProgressBar x:Name="SetupProgress" Height="4" Minimum="0" Maximum="5" IsTabStop="False"/>
     </StackPanel>
     <ScrollViewer x:Name="SetupGuideScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
     <StackPanel Spacing="16">
      <InfoBar x:Name="SetupFailure" IsOpen="False" Severity="Warning" IsClosable="False"/>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
        <FontIcon x:Name="SetupStepIcon" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
       </Border>
       <TextBlock x:Name="SetupStepTitle" Grid.Column="1" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" IsTabStop="True" AutomationProperties.HeadingLevel="Level1"/>
      </Grid>
      <TextBlock x:Name="SetupStepSummary" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
       <TextBlock x:Name="SetupStepInstructions" TextWrapping="Wrap" LineHeight="22" IsTextSelectionEnabled="True"/>
      </Border>
      <InfoBar x:Uid="SetupImportantNote" x:Name="SetupImportantNote" IsOpen="False" IsClosable="False" Severity="Warning"/>
      <HyperlinkButton x:Name="SetupStepLink" HorizontalAlignment="Left" Padding="0" Click="SetupStepLink_Click"/>
      <Expander x:Name="SetupDetails" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
       <Expander.Header><TextBlock x:Name="SetupDetailsHeading" TextWrapping="Wrap"/></Expander.Header>
       <StackPanel Spacing="12">
        <TextBlock x:Name="SetupStepDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        <TextBlock x:Name="SetupStepNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       </StackPanel>
      </Expander>
      <InfoBar x:Name="SetupGuideNotice" IsOpen="False" Severity="Informational" IsClosable="True" Closed="SetupGuideNotice_Closed"/>
      <Expander x:Uid="SetupSupportActions" x:Name="SetupSupportActions" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
       <StackPanel Spacing="12">
        <TextBlock x:Uid="ShareTheErrorAndAppTextBlock" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Button x:Uid="CopyErrorDetailsButton" Click="CopySignInError_Click" HorizontalAlignment="Stretch"/>
        <Button x:Uid="OpenDiagnosticLogFolderButton" Click="OpenAuthLogs_Click" HorizontalAlignment="Stretch"/>
       </StackPanel>
      </Expander>
     </StackPanel>
     </ScrollViewer>
     <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,20,0,0">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Uid="SetupBack" x:Name="SetupBack" Click="SetupBack_Click" HorizontalAlignment="Left"/>
       <HyperlinkButton x:Uid="SetupDemo" x:Name="SetupDemo" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="SetupDemo_Click"/>
       <Button x:Uid="SetupNext" x:Name="SetupNext" Grid.Column="1" MinWidth="96" Style="{ThemeResource AccentButtonStyle}" Click="SetupNext_Click"/>
      </Grid>
     </Border>
     </Grid>
    </Border>
  </Grid>
  <TeachingTip x:Name="AppTourTip" IsOpen="False" IsLightDismissEnabled="False" ShouldConstrainToRootBounds="True"
               PreferredPlacement="Bottom" ActionButtonStyle="{ThemeResource AccentButtonStyle}" ActionButtonClick="TourNext_Click" CloseButtonClick="TourSkip_Click" Closed="TourTip_Closed">
   <TeachingTip.Content>
    <StackPanel Spacing="14" MaxWidth="300">
     <TextBlock x:Name="TourDescription" TextWrapping="Wrap" IsTabStop="True"/>
     <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" Padding="12" CornerRadius="8"><TextBlock x:Name="TourHint" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border>
     <ProgressBar x:Name="TourProgress" Minimum="0" Maximum="6" Height="3" IsTabStop="False"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="TourStepLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Uid="TourBack" x:Name="TourBack" Grid.Column="1" Click="TourBack_Click" Style="{ThemeResource SubtleButtonStyle}"/>
     </Grid>
    </StackPanel>
   </TeachingTip.Content>
  </TeachingTip>
 </Grid>
</Window>
