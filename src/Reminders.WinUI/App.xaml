<Application x:Class="Reminders.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="SettingsCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/>
   </Style>
   <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/>
   </Style>
   <Style x:Key="SettingsChoiceStyle" TargetType="ComboBox">
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="12,8,12,8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
   </Style>
   <Style x:Key="SettingsActionStyle" TargetType="Button">
    <Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="16,10"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
   </Style>
   <Style x:Key="EditorSectionStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14"/>
   </Style>
   <Style x:Key="TaskTitleEditorStyle" TargetType="TextBox">
    <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="12,10"/>
   </Style>
   <Style x:Key="TaskNotesEditorStyle" TargetType="TextBox">
    <Setter Property="Header" Value="Notes"/><Setter Property="PlaceholderText" Value="Add notes…"/>
    <Setter Property="AcceptsReturn" Value="True"/><Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="MinHeight" Value="64"/><Setter Property="MaxHeight" Value="180"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
