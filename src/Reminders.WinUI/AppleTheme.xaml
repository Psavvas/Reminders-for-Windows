<ResourceDictionary
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Reminders.Windows">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Default">
   <SolidColorBrush x:Key="AppleSidebarBrush" Color="#F5F5F7"/>
   <SolidColorBrush x:Key="AppleCanvasBrush" Color="White"/>
   <SolidColorBrush x:Key="AppleFieldBrush" Color="White"/>
   <SolidColorBrush x:Key="AppleTextBrush" Color="#1D1D1F"/>
   <SolidColorBrush x:Key="AppleSecondaryBrush" Color="#737378"/>
   <SolidColorBrush x:Key="AppleDividerBrush" Color="#D9D9DE"/>
   <SolidColorBrush x:Key="AppleSelectionBrush" Color="#E5E5EA"/>
   <SolidColorBrush x:Key="AppleHoverBrush" Color="#EFEFF2"/>
   <SolidColorBrush x:Key="AppleBlueBrush" Color="#3478F6"/>
   <SolidColorBrush x:Key="AppleRedBrush" Color="#FF3B30"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Dark">
   <SolidColorBrush x:Key="AppleSidebarBrush" Color="#242426"/>
   <SolidColorBrush x:Key="AppleCanvasBrush" Color="#1C1C1E"/>
   <SolidColorBrush x:Key="AppleFieldBrush" Color="#343437"/>
   <SolidColorBrush x:Key="AppleTextBrush" Color="#F5F5F7"/>
   <SolidColorBrush x:Key="AppleSecondaryBrush" Color="#A1A1A6"/>
   <SolidColorBrush x:Key="AppleDividerBrush" Color="#424245"/>
   <SolidColorBrush x:Key="AppleSelectionBrush" Color="#3A3A3C"/>
   <SolidColorBrush x:Key="AppleHoverBrush" Color="#303033"/>
   <SolidColorBrush x:Key="AppleBlueBrush" Color="#5A98FF"/>
   <SolidColorBrush x:Key="AppleRedBrush" Color="#FF6961"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="AppleSidebarBrush" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="AppleCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="AppleFieldBrush" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="AppleTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="AppleSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="AppleDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="AppleSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
   <SolidColorBrush x:Key="AppleHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
   <SolidColorBrush x:Key="AppleBlueBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
   <SolidColorBrush x:Key="AppleRedBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>

 <Style x:Key="WindowsReminderHostStyle" TargetType="Grid">
  <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
 </Style>
 <Style x:Key="WindowsDetailsHostStyle" TargetType="Grid">
  <Setter Property="Background" Value="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
 </Style>
 <Style x:Key="AppleToolbarButtonStyle" TargetType="Button">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Foreground" Value="{ThemeResource AppleBlueBrush}"/>
  <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
  <Setter Property="Padding" Value="6"/><Setter Property="CornerRadius" Value="18"/>
 </Style>
 <Style x:Key="AppleRowStyle" TargetType="ListViewItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/>
  <Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="ListViewItem">
    <Border x:Name="RowBackground" Background="Transparent" CornerRadius="11">
     <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="CommonStates">
       <VisualState x:Name="Normal"/>
       <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="RowBackground.Background" Value="{ThemeResource AppleHoverBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="RowBackground.Background" Value="{ThemeResource AppleSelectionBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="RowBackground.Background" Value="{ThemeResource AppleSelectionBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="RowBackground.Background" Value="{ThemeResource AppleSelectionBrush}"/></VisualState.Setters></VisualState>
       <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="RowBackground.Background" Value="{ThemeResource AppleSelectionBrush}"/></VisualState.Setters></VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="DisabledStates"><VisualState x:Name="Enabled"/><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="RowBackground.Opacity" Value="0.5"/></VisualState.Setters></VisualState></VisualStateGroup>
     </VisualStateManager.VisualStateGroups>
     <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"/>
    </Border>
   </ControlTemplate></Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="AppleCheckBoxStyle" TargetType="CheckBox">
  <Setter Property="MinWidth" Value="28"/><Setter Property="MinHeight" Value="28"/>
  <Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Grid x:Name="CheckRoot" Width="28" Height="28" Background="Transparent">
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="CommonStates">
      <VisualState x:Name="Normal"/>
      <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Ring.Stroke" Value="{ThemeResource AppleBlueBrush}"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="CheckRoot.Opacity" Value="0.65"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="CheckRoot.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="CheckStates">
      <VisualState x:Name="Unchecked"/>
      <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Ring.Fill" Value="{ThemeResource AppleBlueBrush}"/><Setter Target="Ring.Stroke" Value="{ThemeResource AppleBlueBrush}"/><Setter Target="CheckMark.Visibility" Value="Visible"/></VisualState.Setters></VisualState>
      <VisualState x:Name="Indeterminate"/>
     </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Ellipse x:Name="Ring" Width="22" Height="22" Stroke="{ThemeResource AppleSecondaryBrush}" StrokeThickness="1.2"/>
    <FontIcon x:Name="CheckMark" Glyph="&#xE73E;" FontSize="12" Foreground="White" Visibility="Collapsed"/>
   </Grid>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <DataTemplate x:Key="AppleFieldHeaderTemplate">
  <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppleSecondaryBrush}" Margin="4,0,0,8"/>
 </DataTemplate>
</ResourceDictionary>
